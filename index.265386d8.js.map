"use strict";
var menuButtons = document.querySelectorAll(".trigger-nav--js");
var menu = document.querySelector(".header__opennav-nav");
var menuLinks = document.querySelectorAll(".header__opennav-nav-link");
menuButtons.forEach(function(btn) {
    btn.addEventListener("click", function(event) {
        event.preventDefault();
        menu.classList.toggle("header__opennav-nav--active");
        document.body.classList.toggle("scroll-hidden");
    });
});
menuLinks.forEach(function(link) {
    link.addEventListener("click", function() {
        menu.classList.remove("header__opennav-nav--active");
        document.body.classList.remove("scroll-hidden");
    });
});

